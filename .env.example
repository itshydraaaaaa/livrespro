# =============================================================================
# LivresPro.tn — Environment Configuration Example
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# Base URL of the website
BASE_URL=https://livrespro.tn

# MySQL Database Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://livrespro_user:YourStrongPassword@127.0.0.1:3306/livrespro_db

# Session Cookie Secret Key (At least 32 random characters for JWT signing)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Default Administrator Account (Used during initial seeding)
ADMIN_EMAIL=admin@livrespro.tn
ADMIN_INITIAL_PASSWORD=AdminLivresPro2026!

# Notification Settings (Optional / For future email integrations)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@livrespro.tn
# SMTP_PASS=your_smtp_password
# ORDER_NOTIFICATION_EMAIL=commandes@livrespro.tn
