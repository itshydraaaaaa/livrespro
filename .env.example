# =============================================================================
# LivresPro.tn — Environment Configuration Example
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=3000

# Base URL of the website
BASE_URL=https://livrespro.tn

# Supabase Database & API Keys
# Find your Project URL in Supabase Dashboard > Settings > API (https://<project-ref>.supabase.co)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# Direct Database Connection String (Optional / For Drizzle direct PostgreSQL connection)
# Format: postgresql://postgres.[project-ref]:[DB_PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Session Cookie Secret Key (At least 32 random characters for JWT signing)
JWT_SECRET=livrespro-production-secret-key-at-least-32-chars

# Default Administrator Account (Used during initial seeding & demo)
ADMIN_EMAIL=admin@livrespro.tn
ADMIN_INITIAL_PASSWORD=AdminLivresPro2026!
